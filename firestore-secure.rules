rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'davidforgot7727@gmail.com',
          'timeslatitude@gmail.com',
          'johsu@beast-kingdom.com.tw'
        ];
    }

    function isPublicTrip(tripId) {
      return tripId == 'fukuoka-2026-family';
    }

    // 只有目前這趟行程、共同清單與伴手禮公開可讀；只有家人能修改。
    match /trips/{tripId}/itinerary/{documentId} {
      allow read: if isPublicTrip(tripId);
      allow create, update, delete: if isFamily();
    }

    match /trips/{tripId}/checklist/{documentId} {
      allow read: if isPublicTrip(tripId);
      allow create, update, delete: if isFamily();
    }

    match /trips/{tripId}/gifts/{documentId} {
      allow read: if isPublicTrip(tripId);
      allow create, update, delete: if isFamily();
    }

    // 此旅程的折價券公開可讀、可新增；修改與刪除仍由家人管理。
    match /trips/{tripId}/coupons/{documentId} {
      allow read: if isPublicTrip(tripId);
      allow create: if isPublicTrip(tripId)
        && request.resource.data.keys().hasAll(['imageData', 'title', 'shop', 'url', 'expires', 'note', 'createdAt', 'updatedAt', 'uid', 'editorName'])
        && request.resource.data.keys().hasOnly(['imageData', 'title', 'shop', 'url', 'expires', 'note', 'createdAt', 'updatedAt', 'uid', 'editorName'])
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() <= 550000
        && request.resource.data.imageData.matches('data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+')
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
        && request.resource.data.shop is string && request.resource.data.shop.size() <= 60
        && request.resource.data.url is string && request.resource.data.url.size() <= 500
        && (request.resource.data.url == '' || request.resource.data.url.matches('https?://.+'))
        && request.resource.data.expires is string && request.resource.data.expires.size() <= 10
        && request.resource.data.note is string && request.resource.data.note.size() <= 120
        && request.resource.data.uid is string && request.resource.data.uid.size() <= 128
        && request.resource.data.editorName in ['家人', '訪客']
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if isFamily();
    }

    // 發票照片只在使用者裝置上做 OCR，不上傳；確認後的文字與金額限家人共用。
    match /trips/{tripId}/receipts/{documentId} {
      allow read: if isFamily();
      allow create, update: if isFamily()
        && request.resource.data.keys().hasAll(['shop', 'receiptDate', 'total', 'tax', 'currency', 'items', 'note', 'ocrConfidence', 'createdAt', 'updatedAt', 'uid', 'editorName'])
        && request.resource.data.keys().hasOnly(['shop', 'receiptDate', 'total', 'tax', 'currency', 'items', 'note', 'ocrConfidence', 'createdAt', 'updatedAt', 'uid', 'editorName'])
        && request.resource.data.shop is string
        && request.resource.data.shop.size() > 0 && request.resource.data.shop.size() <= 80
        && request.resource.data.receiptDate is string && request.resource.data.receiptDate.size() == 10
        && request.resource.data.total is number && request.resource.data.total > 0 && request.resource.data.total <= 99999999
        && request.resource.data.tax is number && request.resource.data.tax >= 0 && request.resource.data.tax <= 99999999
        && request.resource.data.currency == 'JPY'
        && request.resource.data.items is list && request.resource.data.items.size() <= 60
        && request.resource.data.note is string && request.resource.data.note.size() <= 240
        && request.resource.data.ocrConfidence is number && request.resource.data.ocrConfidence >= 0 && request.resource.data.ocrConfidence <= 100
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.editorName is string && request.resource.data.editorName.size() <= 24
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time;
      allow delete: if isFamily();
    }

    // AI 還原備份維持家人專用；這個集合也用來驗證家人權限。
    match /trips/{tripId}/itineraryBackups/{documentId} {
      allow read, write: if isFamily();
    }

    // 重要文件只同步 Drive 捷徑與備註；所有家人帳號可查看與維護。
    match /trips/{tripId}/secureLinks/{documentId} {
      allow read, write: if isFamily();
    }

    // 孕期、保險、MEDIF 進度與預約代碼不公開，只限家人帳號同步。
    match /trips/{tripId}/privateStatus/{documentId} {
      allow read, write: if isFamily();
    }

    // 未明確列出的旅程集合預設拒絕，不使用寬鬆的遞迴規則。
  }
}
